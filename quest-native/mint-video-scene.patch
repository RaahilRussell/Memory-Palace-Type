+    void LoadMintScene() {
+        const std::string scene = ReadAsset("mint.scene");
+        if (scene.size() < 56 || scene.compare(0, 4, "M3D1") != 0) THROW("The bundled Mint scene has an invalid header.");
+        size_t offset = 4;
+        m_roomWidth = ReadU32(scene, offset); m_roomHeight = ReadU32(scene, offset);
+        m_actorWidth = ReadU32(scene, offset); m_actorHeight = ReadU32(scene, offset);
+        m_mintFrameCount = ReadU32(scene, offset); const uint32_t keyframeCount = ReadU32(scene, offset);
+        m_sceneNear = ReadFloat(scene, offset); m_sceneFar = ReadFloat(scene, offset);
+        m_sceneFov = ReadFloat(scene, offset); m_sceneStrength = ReadFloat(scene, offset);
+        m_sceneDuration = ReadFloat(scene, offset); m_tinRadius = ReadFloat(scene, offset); m_tinThickness = ReadFloat(scene, offset);
+        if (!m_roomWidth || !m_roomHeight || !m_actorWidth || !m_actorHeight || !m_mintFrameCount || m_mintFrameCount > 2000 || !keyframeCount || keyframeCount > 128 || m_sceneNear <= 0 || m_sceneFar <= m_sceneNear || m_sceneFov <= 0 || m_sceneDuration <= 0)
+            THROW("The bundled Mint scene dimensions or timing are invalid.");
+        m_actorTimes.resize(m_mintFrameCount);
+        for (float& time : m_actorTimes) time = ReadFloat(scene, offset);
+        m_tinFrames.resize(keyframeCount);
+        for (MintKeyframe& frame : m_tinFrames) {
+            frame.time = ReadFloat(scene, offset); frame.u = ReadFloat(scene, offset); frame.v = ReadFloat(scene, offset);
+            frame.depth = ReadFloat(scene, offset); frame.rx = ReadFloat(scene, offset); frame.ry = ReadFloat(scene, offset); frame.rz = ReadFloat(scene, offset);
+            frame.depth = std::max(0.28f, frame.depth * 0.62f);
+            frame.visible = ReadU32(scene, offset) != 0; ReadU32(scene, offset);
+        }
+        if (offset != scene.size()) THROW("The bundled Mint scene has trailing data.");
+        m_sceneAspect = static_cast<float>(m_actorWidth * 2) / static_cast<float>(m_actorHeight * 2);
+
+        const std::string depthBytes = ReadAsset("room-depth.png");
+        int depthWidth = 0, depthHeight = 0, depthChannels = 0;
+        unsigned char* depthPixels = stbi_load_from_memory(reinterpret_cast<const stbi_uc*>(depthBytes.data()), static_cast<int>(depthBytes.size()), &depthWidth, &depthHeight, &depthChannels, STBI_rgb_alpha);
+        if (!depthPixels || depthWidth != static_cast<int>(m_roomWidth) || depthHeight != static_cast<int>(m_roomHeight)) THROW("The Mint room depth map does not match its scene header.");
+        const size_t roomCount = static_cast<size_t>(m_roomWidth) * m_roomHeight;
+        std::vector<VenueVertex> roomVertices;
+        m_roomGrid.resize(roomCount);
+        std::vector<float> distances(roomCount);
+        const float halfHeight = std::tan(m_sceneFov * 0.00872664626f);
+        for (uint32_t y = 0; y < m_roomHeight; ++y) for (uint32_t x = 0; x < m_roomWidth; ++x) {
+            const size_t i = static_cast<size_t>(y) * m_roomWidth + x;
+            const float inverseDepth = depthPixels[i * 4] / 255.0f;
+            const float distance = m_sceneNear + (1.0f / (inverseDepth / m_sceneNear + (1.0f - inverseDepth) / m_sceneFar) - m_sceneNear) * m_sceneStrength;
+            distances[i] = distance;
+            m_roomGrid[i] = VenueVertex{{((static_cast<float>(x) / (m_roomWidth - 1) * 2.0f - 1.0f) * halfHeight * m_sceneAspect * distance),
+                ((1.0f - static_cast<float>(y) / (m_roomHeight - 1) * 2.0f) * halfHeight * distance), -distance},
+                {static_cast<float>(x) / (m_roomWidth - 1), static_cast<float>(y) / (m_roomHeight - 1)}};
+        }
+        stbi_image_free(depthPixels);
+        auto appendRoomTriangle = [&](size_t a, size_t b, size_t c) {
+            const float closest = std::min({distances[a], distances[b], distances[c]});
+            const float farthest = std::max({distances[a], distances[b], distances[c]});
+            if (farthest - closest > std::max(0.24f * m_sceneStrength, closest * 0.12f)) return;
+            roomVertices.push_back(m_roomGrid[a]); roomVertices.push_back(m_roomGrid[b]); roomVertices.push_back(m_roomGrid[c]);
+        };
+        for (uint32_t y = 0; y + 1 < m_roomHeight; ++y) for (uint32_t x = 0; x + 1 < m_roomWidth; ++x) {
+            const size_t a = static_cast<size_t>(y) * m_roomWidth + x;
+            appendRoomTriangle(a, a + m_roomWidth, a + 1);
+            appendRoomTriangle(a + 1, a + m_roomWidth, a + m_roomWidth + 1);
+        }
+        m_venueVertexCount = static_cast<GLsizei>(roomVertices.size());
+        glGenBuffers(1, &m_venueVertexBuffer); glBindBuffer(GL_ARRAY_BUFFER, m_venueVertexBuffer);
+        glBufferData(GL_ARRAY_BUFFER, roomVertices.size() * sizeof(VenueVertex), roomVertices.data(), GL_STATIC_DRAW);
+        m_venueTexture = LoadMintTexture("room.jpg", false);
