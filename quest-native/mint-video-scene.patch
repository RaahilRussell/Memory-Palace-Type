+    void BuildTinMesh() {
+        std::vector<VenueVertex> vertices;
+        constexpr int segments = 48;
+        const auto vertex = [](float x, float y, float z, float u, float v) {
+            return VenueVertex{{x, y, z}, {u, v}};
+        };
+        for (int i = 0; i < segments; ++i) {
+            const float a = 6.28318530718f * i / segments;
+            const float b = 6.28318530718f * (i + 1) / segments;
+            const float u0 = 0.5f + static_cast<float>(i) / segments * 0.5f;
+            const float u1 = 0.5f + static_cast<float>(i + 1) / segments * 0.5f;
+            const auto bottomA = vertex(std::cos(a), -0.5f, std::sin(a), u0, 0.96f);
+            const auto bottomB = vertex(std::cos(b), -0.5f, std::sin(b), u1, 0.96f);
+            const auto topA = vertex(std::cos(a), 0.5f, std::sin(a), u0, 0.04f);
+            const auto topB = vertex(std::cos(b), 0.5f, std::sin(b), u1, 0.04f);
+            vertices.insert(vertices.end(), {bottomA, bottomB, topB, bottomA, topB, topA});
+            const float x0 = std::cos(a), z0 = std::sin(a), x1 = std::cos(b), z1 = std::sin(b);
+            vertices.insert(vertices.end(), {
+                vertex(0, 0.5f, 0, 0.25f, 0.5f), vertex(x1, 0.5f, z1, 0.25f + x1 * 0.23f, 0.5f + z1 * 0.46f),
+                vertex(x0, 0.5f, z0, 0.25f + x0 * 0.23f, 0.5f + z0 * 0.46f),
+                vertex(0, -0.5f, 0, 0.25f, 0.5f), vertex(x0, -0.5f, z0, 0.25f + x0 * 0.23f, 0.5f + z0 * 0.46f),
+                vertex(x1, -0.5f, z1, 0.25f + x1 * 0.23f, 0.5f + z1 * 0.46f)
+            });
+        }
+        m_tinVertexCount = static_cast<GLsizei>(vertices.size());
+        glGenBuffers(1, &m_tinVertexBuffer);
+        glBindBuffer(GL_ARRAY_BUFFER, m_tinVertexBuffer);
+        glBufferData(GL_ARRAY_BUFFER, vertices.size() * sizeof(VenueVertex), vertices.data(), GL_STATIC_DRAW);
+    }
