+    uint32_t ReadU32(const std::string& bytes, size_t& offset) {
+        if (offset + 4 > bytes.size()) THROW("The bundled Mint scene header is truncated.");
+        uint32_t value = 0;
+        std::memcpy(&value, bytes.data() + offset, sizeof(value));
+        offset += sizeof(value);
+        return value;
+    }
+
+    float ReadFloat(const std::string& bytes, size_t& offset) {
+        if (offset + 4 > bytes.size()) THROW("The bundled Mint scene header is truncated.");
+        float value = 0;
+        std::memcpy(&value, bytes.data() + offset, sizeof(value));
+        offset += sizeof(value);
+        return value;
+    }
