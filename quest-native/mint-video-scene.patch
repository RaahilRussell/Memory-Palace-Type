+    void LoadMintHuman() {
+        const std::string bytes = ReadAsset("human.mesh");
+        if (bytes.size() < 36 || bytes.compare(0, 4, "H3D2") != 0) THROW("The bundled 3D human mesh has an invalid header.");
+        size_t offset = 4;
+        m_humanVertexCount = ReadU32(bytes, offset);
+        m_humanIndexCount = ReadU32(bytes, offset);
+        m_humanFrameCount = ReadU32(bytes, offset);
+        m_humanFps = ReadU32(bytes, offset);
+        m_humanFrameInterval = ReadFloat(bytes, offset);
+        m_humanStartTime = ReadFloat(bytes, offset);
+        m_humanPositionScale = ReadU32(bytes, offset);
+        m_humanNormalScale = ReadU32(bytes, offset);
+        if (!m_humanVertexCount || !m_humanIndexCount || m_humanIndexCount % 3 || !m_humanFrameCount ||
+            !m_humanFps || m_humanFrameInterval <= 0 || m_humanPositionScale == 0 || m_humanNormalScale != 127 ||
+            m_humanVertexCount > 100000 || m_humanIndexCount > 600000 || m_humanFrameCount > 1000)
+            THROW("The bundled 3D human mesh dimensions or timing are invalid.");
+        const size_t colorBytes = static_cast<size_t>(m_humanVertexCount) * 3;
+        const size_t indexBytes = static_cast<size_t>(m_humanIndexCount) * sizeof(uint32_t);
+        const size_t frameBytes = static_cast<size_t>(m_humanVertexCount) * 3 * sizeof(int16_t);
+        const size_t normalFrameBytes = static_cast<size_t>(m_humanVertexCount) * 3 * sizeof(int8_t);
+        const size_t allFramesBytes = (frameBytes + normalFrameBytes) * m_humanFrameCount;
+        const size_t expected = offset + colorBytes + indexBytes + allFramesBytes;
+        if (expected != bytes.size()) THROW("The bundled 3D human mesh is truncated or has trailing bytes.");
+        m_humanColors.assign(bytes.begin() + offset, bytes.begin() + offset + colorBytes);
+        offset += colorBytes;
+        m_humanIndices.resize(m_humanIndexCount);
+        std::memcpy(m_humanIndices.data(), bytes.data() + offset, indexBytes);
+        offset += indexBytes;
+        for (uint32_t index : m_humanIndices) if (index >= m_humanVertexCount) THROW("The 3D human mesh has an invalid triangle index.");
+        m_humanFrameData.assign(bytes.data() + offset, bytes.data() + bytes.size());
+        m_humanPositions.resize(static_cast<size_t>(m_humanVertexCount) * 3);
+        m_humanPackedFrame.resize(m_humanPositions.size());
+        m_humanPackedNormals.resize(m_humanPositions.size());
+        glGenBuffers(1, &m_humanPositionBuffer);
+        glBindBuffer(GL_ARRAY_BUFFER, m_humanPositionBuffer);
+        glBufferData(GL_ARRAY_BUFFER, m_humanPositions.size() * sizeof(float), nullptr, GL_DYNAMIC_DRAW);
+        glGenBuffers(1, &m_humanColorBuffer);
+        glBindBuffer(GL_ARRAY_BUFFER, m_humanColorBuffer);
+        glBufferData(GL_ARRAY_BUFFER, m_humanColors.size(), m_humanColors.data(), GL_STATIC_DRAW);
+        glGenBuffers(1, &m_humanNormalBuffer);
+        glBindBuffer(GL_ARRAY_BUFFER, m_humanNormalBuffer);
+        glBufferData(GL_ARRAY_BUFFER, m_humanPackedNormals.size(), nullptr, GL_DYNAMIC_DRAW);
+        glGenBuffers(1, &m_humanIndexBuffer);
+        glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, m_humanIndexBuffer);
+        glBufferData(GL_ELEMENT_ARRAY_BUFFER, indexBytes, m_humanIndices.data(), GL_STATIC_DRAW);
+        m_humanLoaded = true;
+        UpdateMintHumanFrame(m_humanStartTime);
+        Log::Write(Log::Level::Info, Fmt("Loaded volumetric Mint human (%u vertices, %u triangles, %u baked poses).", m_humanVertexCount, m_humanIndexCount / 3, m_humanFrameCount));
+    }
+
+    void UpdateMintHumanFrame(float time) {
+        m_humanVisible = m_humanLoaded && time >= m_humanStartTime && time <= m_humanStartTime + (m_humanFrameCount - 1) * m_humanFrameInterval;
+        if (!m_humanVisible) return;
+        const uint32_t frameIndex = std::min(static_cast<uint32_t>(std::lround((time - m_humanStartTime) / m_humanFrameInterval)), m_humanFrameCount - 1);
+        if (frameIndex == m_lastHumanFrame) return;
+        const size_t frameStride = static_cast<size_t>(m_humanVertexCount) * 3 * sizeof(int16_t);
+        const size_t normalStride = static_cast<size_t>(m_humanVertexCount) * 3 * sizeof(int8_t);
+        const size_t positionFramesBytes = frameStride * m_humanFrameCount;
+        std::memcpy(m_humanPackedFrame.data(), m_humanFrameData.data() + frameStride * frameIndex, frameStride);
+        std::memcpy(m_humanPackedNormals.data(), m_humanFrameData.data() + positionFramesBytes + normalStride * frameIndex, normalStride);
+        const float invScale = 1.0f / m_humanPositionScale;
+        float nearestDepth = std::numeric_limits<float>::max();
+        float farthestDepth = 0.0f;
+        for (size_t i = 0; i < m_humanPositions.size(); i += 3) {
+            m_humanPositions[i] = m_humanPackedFrame[i] * invScale;
+            m_humanPositions[i + 1] = m_humanPackedFrame[i + 1] * invScale;
+            m_humanPositions[i + 2] = m_humanPackedFrame[i + 2] * invScale;
+            const float depth = -m_humanPositions[i + 2];
+            nearestDepth = std::min(nearestDepth, depth);
+            farthestDepth = std::max(farthestDepth, depth);
+        }
+        m_humanCenterDepth = (nearestDepth + farthestDepth) * 0.5f;
+        m_humanDepthSpan = std::clamp(farthestDepth - nearestDepth, 0.12f, 0.75f);
+        glBindBuffer(GL_ARRAY_BUFFER, m_humanPositionBuffer);
+        glBufferSubData(GL_ARRAY_BUFFER, 0, m_humanPositions.size() * sizeof(float), m_humanPositions.data());
+        glBindBuffer(GL_ARRAY_BUFFER, m_humanNormalBuffer);
+        glBufferSubData(GL_ARRAY_BUFFER, 0, m_humanPackedNormals.size(), m_humanPackedNormals.data());
+        m_lastHumanFrame = frameIndex;
+    }
