+                    VenueVertex v{};
+                    v.position[0] = c * (p[0] - spawnX) + s * (p[2] - spawnZ);
+                    v.position[1] = p[1] - 1.9f;
+                    v.position[2] = -s * (p[0] - spawnX) + c * (p[2] - spawnZ);
+                    v.uv[0] = uv[0]; v.uv[1] = uv[1]; vertices.push_back(v);
+                };
+                for (size_t i = 1; i + 1 < face.size(); ++i) { append(face[0]); append(face[i]); append(face[i + 1]); }
+            }
