+            std::string kind; row >> kind;
+            if (kind == "v") {
+                std::array<float, 3> p{}; row >> p[0] >> p[1] >> p[2]; positions.push_back(p);
+            } else if (kind == "vt") {
+                std::array<float, 2> uv{}; row >> uv[0] >> uv[1]; uvs.push_back(uv);
+            } else if (kind == "f") {
+                std::vector<std::pair<size_t, size_t>> face;
+                std::string token;
+                while (row >> token) {
+                    const size_t slash = token.find('/');
+                    const size_t next = slash == std::string::npos ? slash : token.find('/', slash + 1);
+                    const int vi = std::stoi(token.substr(0, slash));
+                    const int ti = slash == std::string::npos || slash + 1 == next ? 0 : std::stoi(token.substr(slash + 1, next - slash - 1));
+                    if (positions.empty() || (ti != 0 && uvs.empty())) continue;
